# PostgreSQL
POSTGRES_DB=agromarket
POSTGRES_USER=agromarket
POSTGRES_PASSWORD=agromarket_dev_password
POSTGRES_PORT=5432

# API
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5000
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=agromarket;Username=agromarket;Password=agromarket_dev_password

# JWT Authentication
Jwt__Issuer=AgroMarket.Api
Jwt__Audience=AgroMarket.Clients
Jwt__SigningKey=CHANGE_ME_TO_A_SECURE_64_CHAR_RANDOM_SECRET_KEY_FOR_LOCAL_DEV_ONLY
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=14

# OTP / Telegram
Otp__Provider=Console
Telegram__BotToken=
Telegram__BotUsername=

# Cloudflare R2 (S3-Compatible)
R2__AccountId=
R2__AccessKeyId=
R2__SecretAccessKey=
R2__BucketName=agromarket-media
R2__PublicBaseUrl=
