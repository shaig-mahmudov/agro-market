# Production Domain & SSL (Caddy)
APP_DOMAIN=api.yourdomain.com
ACME_EMAIL=ops@yourdomain.com
# Comma-separated frontend origins allowed by CORS (e.g. your GitHub Pages origin)
CORS_ORIGIN=https://yourusername.github.io

# PostgreSQL (Internal Docker Network)
POSTGRES_DB=agromarket
POSTGRES_USER=agromarket
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD

# JWT Authentication (Minimum 32 characters)
Jwt__Issuer=AgroMarket.Api
Jwt__Audience=AgroMarket.Clients
Jwt__SigningKey=REPLACE_WITH_SECURE_64_CHAR_RANDOM_SECRET_KEY

# Bootstrap Admin Phone (E.164) & Sample Data Seeding
ADMIN_PHONE=+994500000000
SEED_ENABLED=true
SEED_SAMPLE_DATA=true
ENABLE_BOOTSTRAP_DEMO_OTP=true
BOOTSTRAP_OTP_CODE=123456

# OTP & Telegram Bot
Otp__Provider=Telegram
Telegram__BotToken=
Telegram__BotUsername=AgroMarketBot
Telegram__GatewayApiToken=
Telegram__WebhookSecret=
